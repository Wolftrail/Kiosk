# Template only. Never commit real credentials or use a VITE_ prefix.
# Vite reads UNSPLASH_ACCESS_KEY from .env.local; other settings need process env.
# Production: use a protected systemd EnvironmentFile or Node --env-file.
UNSPLASH_ACCESS_KEY=
KIOSK_ADMIN_USERNAME=admin
KIOSK_ADMIN_PASSWORD=
KIOSK_PORT=8080